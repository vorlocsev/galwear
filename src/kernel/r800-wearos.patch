diff --git a/drivers/misc/r800-bt-power.c b/drivers/misc/r800-bt-power.c
new file mode 100644
index 000000000..7ac675d31
--- /dev/null
+++ b/drivers/misc/r800-bt-power.c
@@ -0,0 +1,107 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * SM-R800 Bluetooth power: rfkill switch for the BCM43012 on uart5.
+ *
+ * Replaces Samsung's Tizen bcm43xx driver for the "samsung,bcm43xx" node:
+ *   gpios[0] = BT_EN    (gpg5-1, chip power/reset)
+ *   gpios[1] = BT_WAKE  (gpg2-1, AP -> chip, held high while on: no LPM)
+ *   gpios[2] = HOST_WAKE (gpa1-2, chip -> AP, unused while the AP never sleeps)
+ * The Android Broadcom vendor library powers the chip through rfkill.
+ */
+#include <linux/delay.h>
+#include <linux/gpio.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_gpio.h>
+#include <linux/platform_device.h>
+#include <linux/rfkill.h>
+
+struct r800_bt {
+	int en, wake;
+	struct rfkill *rfk;
+};
+
+static int r800_bt_set_block(void *data, bool blocked)
+{
+	struct r800_bt *bt = data;
+
+	pr_info("r800-bt: power %s\n", blocked ? "off" : "on");
+	if (blocked) {
+		gpio_set_value(bt->wake, 0);
+		gpio_set_value(bt->en, 0);
+	} else {
+		gpio_set_value(bt->en, 0);
+		msleep(20);
+		gpio_set_value(bt->en, 1);
+		gpio_set_value(bt->wake, 1);
+		msleep(100);	/* BCM43012 needs ~50 ms after reset before HCI */
+	}
+	return 0;
+}
+
+static const struct rfkill_ops r800_bt_ops = {
+	.set_block = r800_bt_set_block,
+};
+
+static int r800_bt_probe(struct platform_device *pdev)
+{
+	struct device_node *np = pdev->dev.of_node;
+	struct r800_bt *bt;
+	int ret;
+
+	bt = devm_kzalloc(&pdev->dev, sizeof(*bt), GFP_KERNEL);
+	if (!bt)
+		return -ENOMEM;
+	bt->en = of_get_gpio(np, 0);
+	bt->wake = of_get_gpio(np, 1);
+	if (!gpio_is_valid(bt->en) || !gpio_is_valid(bt->wake)) {
+		dev_err(&pdev->dev, "bad gpios %d %d\n", bt->en, bt->wake);
+		return -EINVAL;
+	}
+	ret = devm_gpio_request_one(&pdev->dev, bt->en, GPIOF_OUT_INIT_LOW, "bt_en");
+	if (!ret)
+		ret = devm_gpio_request_one(&pdev->dev, bt->wake, GPIOF_OUT_INIT_LOW, "bt_wake");
+	if (ret) {
+		dev_err(&pdev->dev, "gpio request failed: %d\n", ret);
+		return ret;
+	}
+
+	bt->rfk = rfkill_alloc("bcm43012", &pdev->dev, RFKILL_TYPE_BLUETOOTH,
+			       &r800_bt_ops, bt);
+	if (!bt->rfk)
+		return -ENOMEM;
+	rfkill_init_sw_state(bt->rfk, true);	/* start powered off */
+	ret = rfkill_register(bt->rfk);
+	if (ret) {
+		rfkill_destroy(bt->rfk);
+		return ret;
+	}
+	platform_set_drvdata(pdev, bt);
+	dev_info(&pdev->dev, "BCM43012 rfkill ready (en %d, wake %d)\n", bt->en, bt->wake);
+	return 0;
+}
+
+static int r800_bt_remove(struct platform_device *pdev)
+{
+	struct r800_bt *bt = platform_get_drvdata(pdev);
+
+	rfkill_unregister(bt->rfk);
+	rfkill_destroy(bt->rfk);
+	return 0;
+}
+
+static const struct of_device_id r800_bt_of_match[] = {
+	{ .compatible = "samsung,bcm43xx" },
+	{ }
+};
+
+static struct platform_driver r800_bt_driver = {
+	.probe = r800_bt_probe,
+	.remove = r800_bt_remove,
+	.driver = {
+		.name = "r800-bt-power",
+		.of_match_table = r800_bt_of_match,
+	},
+};
+module_platform_driver(r800_bt_driver);
+MODULE_LICENSE("GPL");
