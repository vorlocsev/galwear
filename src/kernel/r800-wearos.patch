+	if (data->mag_input_dev) {
+		input_unregister_device(data->mag_input_dev);
+		pr_err("[SSP]: %s, unregister mag input device\n", __func__);
+	}
+	if (data->gyro_input_dev) {
+		input_unregister_device(data->gyro_input_dev);
