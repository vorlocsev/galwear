+void reset_mcu(struct ssp_data *data)
+{
+#if SSP_LDO25_RESET
+	int iRet = 0;
+#endif
+#if SSP_STATUS_MONITOR
+	data->bRefreshing = true;
+#endif
+
+	func_dbg();
+	data->uResetCnt++;
+	data->bSspReady = false;
+	ssp_enable(data, false);
+	clean_pending_list(data);
+#if SSP_STATUS_MONITOR
+	if ((data->reg_hub) && ((current_cable_type == POWER_SUPPLY_TYPE_MAINS)
+		|| (current_cable_type == POWER_SUPPLY_TYPE_HV_MAINS)))
+		toggle_mcu_hw_reset(data);
+	else
+#endif
+
+#if SSP_LDO25_RESET
+	if (data->regulator_3p0v > 0) {
+		iRet = regulator_disable(data->regulator_3p0v);
+		if (iRet < 0)
+			pr_err("[SSP]: %s - SSP_LDO25 disable failed\n", __func__);
+
+		msleep(100);
+	}
+
+	if (data->regulator_3p0v > 0) {
+		iRet = regulator_enable(data->regulator_3p0v);
+		if (iRet < 0)
+			pr_err("[SSP]: %s - SSP_LDO25 enable failed\n", __func__);
+
+		msleep(1);
+	}
+#endif
+		bbd_mcu_reset();
+
+#if SSP_STATUS_MONITOR
+	if ((data->reg_hub) && ((current_cable_type == POWER_SUPPLY_TYPE_MAINS)
+		|| (current_cable_type == POWER_SUPPLY_TYPE_HV_MAINS)))
+		queue_refresh_task(data, 0);
+#endif
+}
