+/*
+ * Local power-domain status tables must consist of unconditional reads.
+ * Validate the whole table before accessing MMIO; never reuse seq->value.
+ * The mapping created by pmucal_rae_init spans SZ_64K per base.
+ */
+int pmucal_rae_read_status(const struct pmucal_seq *seq, unsigned int seq_size)
+{
+	unsigned int i;
+	bool enabled = true;
+
+	if (!seq || !seq_size)
+		return -EINVAL;
+	for (i = 0; i < seq_size; i++) {
+		if (seq[i].access_type != PMUCAL_READ || !seq[i].mask)
+			return -EINVAL;
+		if (!seq[i].base_pa || !seq[i].base_va)
+			return -ENXIO;
+		if ((seq[i].offset & 3) || seq[i].offset > SZ_64K - sizeof(u32))
+			return -EINVAL;
+	}
+
+	for (i = 0; i < seq_size; i++) {
+		u32 value = __raw_readl(seq[i].base_va + seq[i].offset);
+
+		if ((value & seq[i].mask) != seq[i].mask)
+			enabled = false;
+	}
+
+	return enabled ? 1 : 0;
+}
