+/*
+ * Sanity-check an fvmap copy before anything trusts it: every ACPM vclk needs
+ * 1..32 levels with strictly descending positive rates and plausible voltages,
+ * and every offset (rate/volt table, member list, PLL headers) must stay inside
+ * the region. Anything else means the firmware layout differs from this kernel's.
+ */
+static bool fvmap_validate(const void *base)
+{
+	const struct fvmap_header *h = base;
+	int size = cmucal_get_list_size(ACPM_VCLK_TYPE);
+	int i, j;
+
+	if (size <= 0 || size * sizeof(*h) > FVMAP_SIZE) {
+		pr_warn("fvmap: bad vclk count %d\n", size);
+		return false;
+	}
+	for (i = 0; i < size; i++) {
+		const struct rate_volt_header *rv;
+		const struct clocks *clks;
+		unsigned int prev = UINT_MAX;
+
+		pr_warn("fvmap: [%d] type %u lv %u members %u pll %u o_rv %u o_mem %u\n",
+			i, h[i].dvfs_type, h[i].num_of_lv, h[i].num_of_members,
+			h[i].num_of_pll, h[i].o_ratevolt, h[i].o_members);
+		if (!h[i].num_of_lv || h[i].num_of_lv > 32 ||
+		    h[i].o_ratevolt + h[i].num_of_lv * sizeof(struct rate_volt) > FVMAP_SIZE ||
+		    h[i].o_members + h[i].num_of_pll * sizeof(unsigned short) > FVMAP_SIZE)
+			return false;
+		rv = base + h[i].o_ratevolt;
+		for (j = 0; j < h[i].num_of_lv; j++) {
+			unsigned int r = rv->table[j].rate, v = rv->table[j].volt;
+
+			pr_warn("fvmap: [%d]   %7u kHz %7u uV\n", i, r, v);
+			if (!r || r >= prev || v < 450000 || v > 1300000)
+				return false;
+			prev = r;
+		}
+		clks = base + h[i].o_members;
+		for (j = 0; j < h[i].num_of_pll; j++)
+			if (clks->addr[j] + sizeof(struct pll_header) > FVMAP_SIZE)
+				return false;
+	}
+	return true;
+}
+
 int fvmap_init(void __iomem *sram_base)
 {
 	void __iomem *map_base;
+	void *shadow;
 	struct kobject *kobj;
 
 	map_base = kzalloc(FVMAP_SIZE, GFP_KERNEL);
+	shadow = kzalloc(FVMAP_SIZE, GFP_KERNEL);
 
 	fvmap_base = map_base;
 	sram_fvmap_base = sram_base;
 	pr_info("%s:fvmap initialize %p\n", __func__, sram_base);
-	fvmap_copy_from_sram(map_base, sram_base);
+	fvmap_valid = false;
+	if (map_base && shadow) {
+		/* byte-safe copy out of device memory, then parse normal memory */
+		memcpy_fromio(shadow, sram_base, FVMAP_SIZE);
+		if (fvmap_validate(shadow)) {
+			fvmap_copy_from_sram(map_base, (void __iomem *)shadow);
+			fvmap_valid = true;
+			pr_warn("%s: SM-R800: fvmap tables valid, DVFS voltages enabled\n", __func__);
+		} else {
+			pr_warn("%s: SM-R800: fvmap layout not recognised, DVFS tables off\n", __func__);
+		}
+	}
+	kfree(shadow);
 
 	/* percent margin for each doamin at runtime */
 	kobj = kobject_create_and_add("percent_margin", power_kobj);
