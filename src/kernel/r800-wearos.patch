+/*
+ * SM-R800: when bcmdhd power-cycles the BCM43012 (WL_REG_ON), the MMC core
+ * drops the bus to its 400 kHz init clock and nothing raises it again, since
+ * the card is not re-enumerated (sdioh_sdio_reset is a no-op). That capped
+ * Wi-Fi at ~90 KB/s. Put the bus back at the SDIO default-speed rate.
+ */
+void
+sdioh_restore_clock(sdioh_info_t *sd)
+{
+	struct sdio_func *func0 = sd->func[0];
+	uint hz = 25000000;
+
+	if (!func0 || !func0->card)
+		return;
+	if (func0->card->host->ios.clock >= hz)
+		return;
+	sdio_claim_host(func0);
+	sdmmc_set_clock_rate(sd, hz);
+	sdio_release_host(func0);
+}
