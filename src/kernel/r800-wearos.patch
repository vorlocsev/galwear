diff --git a/drivers/soc/samsung/debug/r800-deadman.c b/drivers/soc/samsung/debug/r800-deadman.c
new file mode 100644
index 000000000..6b6987979
--- /dev/null
+++ b/drivers/soc/samsung/debug/r800-deadman.c
@@ -0,0 +1,311 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * r800-deadman.c - bring-up "dead-man" watchdog for the Galaxy Watch SM-R800.
+ *
+ * Arms the Exynos 9110 cluster0 watchdog very early with a long timeout and
+ * never kicks it. Whatever happens afterwards (hang, panic loop, or a
+ * successful boot) the SoC warm-resets after ~R800_DEADMAN_SECS seconds.
+ *
+ * Why: a long-press power reset on this watch is a cold reset that loses DRAM.
+ * A watchdog reset lands in S-Boot's upload screen with DRAM intact; a long
+ * press from there is warm, so Tizen's /proc/last_kmsg then contains this
+ * kernel's debug-snapshot log ring (0x9b010000).
+ *
+ * The regular s3c2410_wdt node must be disabled in the DT: on probe it stops
+ * the watchdog. Register values mirror what Tizen's driver programs
+ * (PMU 0x408/0x40c bit 24, OSC 26 MHz), only with a larger prescaler.
+ */
+#include <linux/clk.h>
+#include <linux/console.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/of.h>
+#include <linux/printk.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/spinlock.h>
+#include <linux/syscore_ops.h>
+#include <linux/moduleparam.h>
+#include <linux/uaccess.h>
+
+/*
+ * RAM console into S-Boot's log ring (same layout Tizen's exynos-snapshot uses):
+ *   header  0x9b000000: +0x200 = u32 phys addr of the write pointer,
+ *                       +0x208 = u32 "ring wrapped" flag
+ *   ring    0x9b010000, 2 MB of plain text
+ * S-Boot appends after the pointer on the next warm boot and Tizen shows the
+ * whole thing as /proc/last_kmsg. Both regions must be no-map in the DT so
+ * they can be mapped uncached (data must survive a watchdog reset).
+ */
+#define RING_HDR_PHYS		0x9b000000
+#define RING_PHYS		0x9b010000
+#define RING_SIZE		SZ_2M
+#define HDR_LAST_LOGBUF		0x200
+#define HDR_CHECK_EOB		0x208
+
+static void __iomem *ring_hdr;
+static void __iomem *ring_buf;
+static u32 ring_pos;
+static DEFINE_RAW_SPINLOCK(ring_lock);
+
+static void r800_ring_write(struct console *con, const char *s, unsigned int n)
+{
+	unsigned long flags;
+
+	if (!ring_buf || n == 0 || n > RING_SIZE)
+		return;
+	raw_spin_lock_irqsave(&ring_lock, flags);
+	if (ring_pos + n > RING_SIZE) {
+		ring_pos = 0;
+		__raw_writel(1, ring_hdr + HDR_CHECK_EOB);
+	}
+	memcpy_toio(ring_buf + ring_pos, s, n);
+	ring_pos += n;
+	wmb();
+	__raw_writel(RING_PHYS + ring_pos, ring_hdr + HDR_LAST_LOGBUF);
+	raw_spin_unlock_irqrestore(&ring_lock, flags);
+}
+
+static struct console r800_ring_console = {
+	.name	= "r800ram",
+	.write	= r800_ring_write,
+	.flags	= CON_PRINTBUFFER | CON_ENABLED | CON_ANYTIME,
+	.index	= -1,
+};
+
+static void __init r800_ring_console_init(void)
+{
+	u32 last;
+
+	ring_hdr = ioremap_wc(RING_HDR_PHYS, SZ_4K);
+	ring_buf = ioremap_wc(RING_PHYS, RING_SIZE);
+	if (!ring_hdr || !ring_buf) {
+		ring_buf = NULL;
+		pr_err("r800-ring: ioremap failed (are header/log_kernel no-map?)\n");
+		return;
+	}
+	/* Continue after whatever S-Boot already wrote for this boot. */
+	last = __raw_readl(ring_hdr + HDR_LAST_LOGBUF);
+	if (last >= RING_PHYS && last < RING_PHYS + RING_SIZE)
+		ring_pos = last - RING_PHYS;
+	else
+		ring_pos = 0;
+
+	console_loglevel = CONSOLE_LOGLEVEL_MOTORMOUTH;	/* capture everything */
+	register_console(&r800_ring_console);
+	pr_emerg("r800-ring: console active, ring pos 0x%x (S-Boot ptr 0x%08x)\n",
+		 ring_pos, last);
+}
+
+#define R800_DEADMAN_SECS	60
+
+#define PMU_BASE		0x11860000
+#define PMU_WDT_DISABLE		0x0408
+#define PMU_WDT_MASK_RESET	0x040c
+#define PMU_WDT_CL0_BIT		BIT(24)
+#define PMU_INFORM3		0x080c
+
+#define WDT_BASE		0x10050000
+#define WTCON			0x00
+#define WTDAT			0x04
+#define WTCNT			0x08
+#define WTCLRINT		0x0c
+
+#define WTCON_RSTEN		BIT(0)
+#define WTCON_DIV128		(3 << 3)
+#define WTCON_ENABLE		BIT(5)
+#define WTCON_PRESCALE(x)	((x) << 8)
+
+#define OSC_HZ			26000000UL
+#define PRESCALE		255	/* divides by 256 */
+
+static void __iomem *r800_wdt;
+static void __iomem *r800_pmu;
+static unsigned long r800_count;
+static bool r800_wdt_on;	/* false once userspace wrote "off" */
+
+static void r800_wdt_start(void)
+{
+	u32 v;
+
+	writel(0, r800_wdt + WTCON);
+	writel(r800_count, r800_wdt + WTDAT);
+	writel(r800_count, r800_wdt + WTCNT);
+	writel(1, r800_wdt + WTCLRINT);
+	/* Unmask the watchdog reset request in the PMU (clear bit = enabled). */
+	v = readl(r800_pmu + PMU_WDT_DISABLE);
+	writel(v & ~PMU_WDT_CL0_BIT, r800_pmu + PMU_WDT_DISABLE);
+	v = readl(r800_pmu + PMU_WDT_MASK_RESET);
+	writel(v & ~PMU_WDT_CL0_BIT, r800_pmu + PMU_WDT_MASK_RESET);
+	writel(WTCON_PRESCALE(PRESCALE) | WTCON_DIV128 | WTCON_ENABLE | WTCON_RSTEN,
+	       r800_wdt + WTCON);
+}
+
+/*
+ * System sleep: nothing can pet the watchdog while the system is suspended,
+ * so stop it on the way down (syscore: last step, one CPU, IRQs off) and
+ * re-arm it with a full period on the way up. A hang inside suspend itself is
+ * no longer covered; one after resume is.
+ */
+/*
+ * Debug: r800_deadman.through_suspend=1 keeps the watchdog running (with a
+ * fresh full period) into sleep. If the SoC really powers down, the watchdog
+ * domain goes down with it and nothing happens; if the CPU instead hangs awake
+ * in firmware, the watchdog resets the board ~60 s later.
+ */
+static int r800_through_suspend;
+module_param_named(through_suspend, r800_through_suspend, int, 0644);
+
+static int r800_deadman_suspend(void)
+{
+	if (r800_wdt && r800_wdt_on) {
+		if (r800_through_suspend)
+			r800_wdt_start();
+		else
+			writel(0, r800_wdt + WTCON);
+	}
+	return 0;
+}
+
+static void r800_deadman_resume(void)
+{
+	if (r800_wdt && r800_wdt_on)
+		r800_wdt_start();
+}
+
+static struct syscore_ops r800_deadman_syscore_ops = {
+	.suspend = r800_deadman_suspend,
+	.resume = r800_deadman_resume,
+};
+
+static int __init r800_deadman_init(void)
+{
+	void __iomem *pmu, *wdt;
+	struct device_node *np;
+	struct clk *clk;
+	unsigned long tick_hz = OSC_HZ / (PRESCALE + 1) / 128;	/* ~793 Hz */
+	unsigned long count = tick_hz * R800_DEADMAN_SECS;
+	u32 v;
+
+	r800_ring_console_init();
+
+	if (count > 0xffff)
+		count = 0xffff;
+
+	/* Keep the watchdog gate clock on so clk_disable_unused() leaves it alone. */
+	np = of_find_compatible_node(NULL, NULL, "samsung,exynos8-wdt");
+	if (np) {
+		clk = of_clk_get_by_name(np, "gate_watchdog");
+		if (!IS_ERR(clk))
+			clk_prepare_enable(clk);
+		else
+			pr_warn("r800-deadman: no gate_watchdog clock (%ld)\n", PTR_ERR(clk));
+		clk = of_clk_get_by_name(np, "rate_watchdog");
+		if (!IS_ERR(clk))
+			clk_prepare_enable(clk);
+		of_node_put(np);
+	}
+
+	pmu = ioremap(PMU_BASE, SZ_4K);
+	wdt = ioremap(WDT_BASE, SZ_4K);
+	if (!pmu || !wdt) {
+		pr_err("r800-deadman: ioremap failed\n");
+		return -ENOMEM;
+	}
+
+	/* Stop, program, then start: same order as s3c2410_wdt. */
+	writel(0, wdt + WTCON);
+	writel(count, wdt + WTDAT);
+	writel(count, wdt + WTCNT);
+	writel(1, wdt + WTCLRINT);
+
+	/* Unmask the watchdog reset request in the PMU (clear bit = enabled). */
+	v = readl(pmu + PMU_WDT_DISABLE);
+	writel(v & ~PMU_WDT_CL0_BIT, pmu + PMU_WDT_DISABLE);
+	v = readl(pmu + PMU_WDT_MASK_RESET);
+	writel(v & ~PMU_WDT_CL0_BIT, pmu + PMU_WDT_MASK_RESET);
+
+	writel(WTCON_PRESCALE(PRESCALE) | WTCON_DIV128 | WTCON_ENABLE | WTCON_RSTEN,
+	       wdt + WTCON);
+
+	/*
+	 * One-shot test boots: S-Boot picks the boot mode from INFORM3 and it
+	 * survives every kind of reset. Tizen's "reboot recovery" left
+	 * 0x1234567b (recovery) there; switch it to normal right away so any
+	 * later reset (panic restart, watchdog, reboot) returns to Tizen.
+	 */
+	v = readl(pmu + PMU_INFORM3);
+	writel(0x12345670, pmu + PMU_INFORM3);
+	pr_emerg("r800-deadman: INFORM3 0x%08x -> 0x%08x (next reset boots Tizen)\n",
+		 v, readl(pmu + PMU_INFORM3));
+
+	pr_emerg("r800-deadman: watchdog armed, reset in ~%lus (count=%lu, WTCON=%08x, PMU %08x/%08x)\n",
+		 count / tick_hz, count, readl(wdt + WTCON),
+		 readl(pmu + PMU_WDT_DISABLE), readl(pmu + PMU_WDT_MASK_RESET));
+
+	/* Mappings are intentionally kept: nothing else touches them. */
+	r800_wdt = wdt;
+	r800_pmu = pmu;
+	r800_count = count;
+	r800_wdt_on = true;
+	register_syscore_ops(&r800_deadman_syscore_ops);
+	return 0;
+}
+early_initcall(r800_deadman_init);
+
+/*
+ * /proc/r800_deadman: lets userspace keep a healthy boot alive.
+ *   echo pet > /proc/r800_deadman   reload the counter (another ~60 s)
+ *   echo off > /proc/r800_deadman   stop the watchdog entirely
+ * If userspace stops petting (hang, crash), the reset still happens.
+ */
+static ssize_t r800_deadman_write(struct file *f, const char __user *ubuf,
+				  size_t len, loff_t *off)
+{
+	char buf[8] = { 0 };
+
+	if (!r800_wdt)
+		return -ENODEV;
+	if (copy_from_user(buf, ubuf, min(len, sizeof(buf) - 1)))
+		return -EFAULT;
+	if (!strncmp(buf, "pet", 3)) {
+		writel(r800_count, r800_wdt + WTCNT);
+	} else if (!strncmp(buf, "off", 3)) {
+		writel(0, r800_wdt + WTCON);
+		r800_wdt_on = false;
+		pr_emerg("r800-deadman: disabled from userspace\n");
+	} else {
+		return -EINVAL;
+	}
+	return len;
+}
+
+static int r800_deadman_show(struct seq_file *m, void *v)
+{
+	if (!r800_wdt)
+		return 0;
+	seq_printf(m, "WTCON=%08x WTCNT=%u count=%lu\n", readl(r800_wdt + WTCON),
+		   readl(r800_wdt + WTCNT), r800_count);
+	return 0;
+}
+
+static int r800_deadman_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, r800_deadman_show, NULL);
+}
+
+static const struct file_operations r800_deadman_fops = {
+	.open		= r800_deadman_open,
+	.read		= seq_read,
+	.write		= r800_deadman_write,
+	.llseek		= seq_lseek,
+	.release	= single_release,
+};
+
+static int __init r800_deadman_proc_init(void)
+{
+	proc_create("r800_deadman", 0600, NULL, &r800_deadman_fops);
+	return 0;
+}
+late_initcall(r800_deadman_proc_init);
