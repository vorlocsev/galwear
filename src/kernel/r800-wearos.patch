+/*
+ * SM-R800: the chip comes up with Broadcom's default address (00:90:4c:...)
+ * on every watch; the factory one lives in CSA (/csa/.mac.info), which Tizen's
+ * driver read. Android's mount namespace has no CSA, so start.sh reads it
+ * before Android and writes it here ("xx:xx:xx:xx:xx:xx"); preinit applies it.
+ */
+static char r800_mac[20];
+module_param_string(r800_mac, r800_mac, sizeof(r800_mac), 0644);
+
+static void r800_apply_factory_mac(dhd_pub_t *dhd)
+{
+	struct ether_addr ea;
+	unsigned int b[6];
+	int i, ret;
+
+	if (sscanf(r800_mac, "%2x:%2x:%2x:%2x:%2x:%2x",
+		   &b[0], &b[1], &b[2], &b[3], &b[4], &b[5]) != 6)
+		return;
+	for (i = 0; i < 6; i++)
+		ea.octet[i] = b[i];
+	if (ETHER_ISNULLADDR(ea.octet) || ETHER_ISMULTI(ea.octet))
+		return;
+	ret = dhd_iovar(dhd, 0, "cur_etheraddr", (char *)&ea, ETHER_ADDR_LEN, NULL, 0, TRUE);
+	if (ret < 0) {
+		DHD_ERROR(("%s: factory MAC not applied (%d)\n", __FUNCTION__, ret));
+		return;
+	}
+	memcpy(dhd->mac.octet, ea.octet, ETHER_ADDR_LEN);
+	DHD_ERROR(("%s: factory MAC applied\n", __FUNCTION__));
+}
