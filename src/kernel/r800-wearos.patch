+	if (g_Ztm620MotorData->gpio_en > 0)
+		*val = gpio_get_value(g_Ztm620MotorData->gpio_en);
+	else {
+		ret = ztm620_motor_reg_read(g_Ztm620MotorData, MOTOR_REG_SOFT_EN);
+		if (ret < 0)
