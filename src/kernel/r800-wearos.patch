diff --git a/drivers/gps/sec_gps_bcm477x.c b/drivers/gps/sec_gps_bcm477x.c
new file mode 100644
index 000000000..d8c228917
--- /dev/null
+++ b/drivers/gps/sec_gps_bcm477x.c
@@ -0,0 +1,148 @@
+/*
+ * BCM477x GPS / sensor hub power enable (gps_pwr_en) for Tizen's lhd.
+ *
+ * r800: originally a device_initcall that read the GPIO straight away; on 4.19 the
+ * CMGP pinctrl (gpm13) is not registered yet at that point and of_get_named_gpio()
+ * returns -EPROBE_DEFER, which an initcall cannot retry. It is now a platform
+ * driver bound to the DT "gps" node, so the probe is deferred until the GPIO exists.
+ * Interface unchanged: /sys/class/gps/gps/gps_pwr_en (lhd's GpioNStdbyPath) and a
+ * platform device named after gps-node-name.
+ */
+#include <linux/platform_device.h>
+#include <linux/io.h>
+#include <linux/gpio.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_gpio.h>
+#include <linux/uaccess.h>
+#include <linux/errno.h>
+#include <linux/err.h>
+#include <linux/types.h>
+
+static struct device *gps_dev;
+struct class *gps_class;
+EXPORT_SYMBOL_GPL(gps_class);
+
+static int gps_pwr_on = -1;
+static struct platform_device *bcm477x;
+
+static ssize_t show_gps_pwr_en(struct device *dev,
+	struct device_attribute *attr, char *buf)
+{
+	int ret;
+
+	ret = gpio_get_value(gps_pwr_on);
+
+	pr_info("%s:%d GPIO_GPS_PWR_EN is %d\n", __func__, __LINE__, ret);
+	return snprintf(buf, PAGE_SIZE, "%d\n", ret);
+}
+
+static ssize_t set_gps_pwr_en(struct device *dev,
+	struct device_attribute *attr, const char *buf, size_t size)
+{
+	int enable;
+
+	if (kstrtoint(buf, 10, &enable) < 0)
+		return -EINVAL;
+
+	pr_info("%s:%d endable:%d\n", __func__, __LINE__, enable);
+	if (enable)
+		gpio_direction_output(gps_pwr_on, 1);
+	else
+		gpio_direction_output(gps_pwr_on, 0);
+
+	return size;
+}
+
+static DEVICE_ATTR(gps_pwr_en, 0640, show_gps_pwr_en, set_gps_pwr_en);
+
+static const struct of_device_id gps_match_table[] = {
+	{
+		.compatible = "broadcom,bcm4774",
+		/* specific node name for Tizen_FW */
+		.data = (void *)"bcm4774",
+	},
+	{
+		.compatible = "broadcom,bcm4775",
+		/* specific node name for Tizen_FW */
+		.data = (void *)"bcm47752",
+	},
+	{},
+};
+MODULE_DEVICE_TABLE(of, gps_match_table);
+
+static int gps_bcm477x_probe(struct platform_device *pdev)
+{
+	struct device_node *np = pdev->dev.of_node;
+	const struct of_device_id *match;
+	const char *name;
+	int gpio, ret;
+
+	gpio = of_get_named_gpio(np, "gps-pwr-en", 0);
+	if (gpio == -EPROBE_DEFER)
+		return -EPROBE_DEFER;
+	if (!gpio_is_valid(gpio)) {
+		dev_err(&pdev->dev, "invalid gps-pwr-en gpio: %d\n", gpio);
+		return -ENODEV;
+	}
+
+	ret = devm_gpio_request(&pdev->dev, gpio, "GPS_PWR_EN");
+	if (ret) {
+		dev_err(&pdev->dev, "fail to request gpio(GPS_PWR_EN): %d\n", ret);
+		return ret;
+	}
+	gps_pwr_on = gpio;
+	gpio_direction_output(gps_pwr_on, 0);
+
+	match = of_match_node(gps_match_table, np);
+	if (of_property_read_string(np, "gps-node-name", &name))
+		name = match ? (const char *)match->data : "bcm4775";
+	bcm477x = platform_device_register_simple(name, -1, NULL, 0);
+	if (IS_ERR(bcm477x)) {
+		dev_err(&pdev->dev, "failed to register %s: %ld\n", name, PTR_ERR(bcm477x));
+		bcm477x = NULL;
+	}
+
+	if (!gps_class) {
+		gps_class = class_create(THIS_MODULE, "gps");
+		if (IS_ERR(gps_class)) {
+			ret = PTR_ERR(gps_class);
+			gps_class = NULL;
+			goto err_pdev;
+		}
+	}
+
+	gps_dev = device_create(gps_class, NULL, 0, NULL, "gps");
+	if (IS_ERR(gps_dev)) {
+		ret = PTR_ERR(gps_dev);
+		goto err_class;
+	}
+
+	ret = device_create_file(gps_dev, &dev_attr_gps_pwr_en);
+	if (ret)
+		goto err_dev;
+
+	dev_info(&pdev->dev, "%s: gps_pwr_en on gpio %d\n", name, gps_pwr_on);
+	return 0;
+
+err_dev:
+	device_destroy(gps_class, 0);
+err_class:
+	class_destroy(gps_class);
+	gps_class = NULL;
+err_pdev:
+	if (bcm477x)
+		platform_device_unregister(bcm477x);
+	bcm477x = NULL;
+	return ret;
+}
+
+static struct platform_driver gps_bcm477x_driver = {
+	.probe = gps_bcm477x_probe,
+	.driver = {
+		.name = "sec_gps_bcm477x",
+		.of_match_table = gps_match_table,
+		.suppress_bind_attrs = true,
+	},
+};
+builtin_platform_driver(gps_bcm477x_driver);
