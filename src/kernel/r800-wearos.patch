+
+	reg[0] = chTempBuf[1];
+	reg[1] = chTempBuf[0];
+	temperature = (short) (((reg[0]) << 8) | reg[1]);
+	ssp_dbg("[SSP]: %s - %d\n", __func__, temperature);
+
+	exit:
+	return temperature;
+}
