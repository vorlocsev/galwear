new file mode 100644
index 000000000..154e995ab
--- /dev/null
+++ b/drivers/video/fbdev/exynos/dpu30/panels/panel-samsung-s6e36w3x01.c
@@ -0,0 +1,399 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung S6E36W3X01 (AMB130MJ04, 360x360) panel for Galaxy Watch SM-R800.
+ *
+ * Power-on init and power-off follow Samsung's Tizen driver
+ * (dpu_9110/panels/s6e36w3x01_l_lcd_ctrl.c: s6e36w3x01_init_ctrl, _enable,
+ * _disable). Reset (gpg3-1) and supplies (LDO21 1.8 V, LDO20 3.3 V) come from
+ * the DT and are driven by exynos_panel_drv.c, so after a real power cycle the
+ * panel is brought up from scratch: the gamma S-Boot programmed is gone, so we
+ * load Tizen's default table, then dim with AID + ELVSS (set_light).
+ */
+
+#include <linux/moduleparam.h>
+#include <video/mipi_display.h>
+#include "exynos_panel_drv.h"
+#include "../dsim.h"
+
+static void s6e36w3x01_read_pm(struct dsim_device *dsim, const char *when)
+{
+	unsigned char buf[3] = { 0 };
+	int ret;
+
+	ret = dsim_read_data(dsim, MIPI_DSI_DCS_READ,
+			MIPI_DCS_GET_POWER_MODE, 1, buf);
+	if (ret < 0)
+		dsim_err("s6e36w3x01: PM read failed (%s): %d\n", when, ret);
+	else
+		dsim_info("s6e36w3x01: PM reg 0x0A = 0x%02x (%s)\n", buf[0], when);
+}
+
+static void s6e36w3x01_write_brightness(struct dsim_device *dsim, u32 lv);
+
+/*
+ * r800 diagnostics: after display-on, read what the panel itself reports about
+ * the link (DSI error count, signal mode, self-diagnostic, power mode). Used to
+ * tell "pixel data never arrives" from "arrives corrupted" after a SLEEP resume.
+ */
+static struct exynos_panel_device *s6e36w3_diag_panel;
+static int s6e36w3_diag_round;
+
+static void s6e36w3x01_diag_read(struct dsim_device *dsim, const char *tag)
+{
+	static const struct { u8 cmd; u8 len; const char *name; } regs[] = {
+		{ 0x0A, 1, "power mode" },
+		{ 0x05, 1, "dsi errors" },
+		{ 0x0E, 1, "signal mode" },
+		{ 0x0F, 1, "diagnostic" },
+		{ 0x0B, 1, "addr mode" },
+		{ 0x0C, 1, "pixel fmt" },
+	};
+	char out[160];
+	int n = 0, i;
+
+	for (i = 0; i < ARRAY_SIZE(regs); i++) {
+		unsigned char buf[4] = { 0 };
+		int ret = dsim_read_data(dsim, MIPI_DSI_DCS_READ, regs[i].cmd, regs[i].len, buf);
+
+		if (ret < 0)
+			n += scnprintf(out + n, sizeof(out) - n, " %02x=ERR%d", regs[i].cmd, ret);
+		else
+			n += scnprintf(out + n, sizeof(out) - n, " %02x=%02x", regs[i].cmd, buf[0]);
+	}
+	dsim_info("s6e36w3x01 diag (%s):%s\n", tag, out);
+}
+
+static void s6e36w3x01_diag_work_fn(struct work_struct *work);
+static DECLARE_DELAYED_WORK(s6e36w3_diag_work, s6e36w3x01_diag_work_fn);
+
+static void s6e36w3x01_diag_work_fn(struct work_struct *work)
+{
+	struct exynos_panel_device *panel = s6e36w3_diag_panel;
+	struct dsim_device *dsim = get_dsim_drvdata(0);
+
+	if (!panel || !dsim || dsim->state != DSIM_STATE_ON)
+		return;
+	mutex_lock(&panel->ops_lock);
+	s6e36w3x01_diag_read(dsim, s6e36w3_diag_round == 0 ? "+0.3s" : "+1.5s");
+	mutex_unlock(&panel->ops_lock);
+	if (s6e36w3_diag_round++ == 0)
+		schedule_delayed_work(&s6e36w3_diag_work, msecs_to_jiffies(1200));
+}
+static u32 s6e36w3_last_lv = 50;	/* restored on every power-on */
+static bool s6e36w3_hlpm;		/* panel is in HLPM */
+static bool s6e36w3_dozing;		/* ambient in normal mode at level 0 */
+/* 1: ambient uses the panel's HLPM (~20 mA, but grainy); 0: normal mode at
+ * the lowest level (clean image). /sys/module/<this>/parameters/r800_hlpm */
+static bool r800_hlpm;		/* default: normal mode */
+module_param(r800_hlpm, bool, 0644);
+static u32 s6e36w3_doze_br = 26;	/* last brightness requested (0-255) */
+
+/* Tizen s6e36w3x01_init_ctrl defaults */
+static u8 s6e36w3_gamma_default[] = {
+	0xCA,
+	0x07, 0x00, 0x00, 0x00,
+	0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80,
+	0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80,
+	0x80, 0x80, 0x80, 0x80, 0x80, 0x80,
+	0x00, 0x00, 0x00,
+};
+static u8 s6e36w3_ffc_on[] = {
+	0xC5,
+	0x09, 0x50, 0x1C, 0x2D, 0x00, 0x05, 0x00, 0x2B,
+	0x67, 0x2F, 0x59, 0x7A, 0x77, 0x10, 0x3D, 0x73,
+	0x00, 0xFF, 0x78, 0x8B, 0x08, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+};
+static u8 s6e36w3_circle_mask[] = {
+	0x7C,
+	0x01, 0x00, 0xB3, 0x00, 0xB3, 0x00, 0xB3, 0x00,
+	0x00, 0x00, 0x01, 0x00, 0x00,
+};
+
+static int s6e36w3x01_suspend(struct exynos_panel_device *panel)
+{
+	struct dsim_device *dsim = get_dsim_drvdata(0);
+
+	DPU_INFO_PANEL("%s +\n", __func__);
+	mutex_lock(&panel->ops_lock);
+	/* Tizen s6e36w3x01_disable */
+	dsim_write_data_seq_delay(dsim, 10, MIPI_DCS_SET_DISPLAY_OFF);
+	dsim_write_data_seq_delay(dsim, 150, MIPI_DCS_ENTER_SLEEP_MODE);
+	mutex_unlock(&panel->ops_lock);
+	DPU_INFO_PANEL("%s -\n", __func__);
+	return 0;
+}
+
+static int s6e36w3x01_displayon(struct exynos_panel_device *panel)
+{
+	struct dsim_device *dsim = get_dsim_drvdata(0);
+
+	DPU_INFO_PANEL("%s +\n", __func__);
+	mutex_lock(&panel->ops_lock);
+
+	/* No read before init: right after a reset the panel answers the read
+	 * but never hands the bus back (BTA), and every following write stalls
+	 * with "line count 0". Tizen's init_ctrl starts with writes too. */
+
+	s6e36w3_hlpm = false;	/* reset/sleep-out puts the panel in normal mode */
+	s6e36w3_dozing = false;
+	/* Tizen s6e36w3x01_init_ctrl */
+	dsim_write_data_seq(dsim, false, 0xF0, 0x5A, 0x5A);		/* test key on */
+	dsim_write_data_seq_delay(dsim, 20, MIPI_DCS_EXIT_SLEEP_MODE);
+	dsim_write_data_seq(dsim, false, MIPI_DCS_SET_TEAR_ON, 0x00);	/* decon uses TE */
+	dsim_write_data_table(dsim, s6e36w3_gamma_default);
+	dsim_write_data_seq(dsim, false, 0xB1, 0x00, 0x10);		/* AID */
+	dsim_write_data_seq(dsim, false, 0xB5, 0x19, 0xDC, 0x13);	/* ELVSS */
+	dsim_write_data_seq(dsim, false, 0xF7, 0x03);			/* gamma update */
+	dsim_write_data_table(dsim, s6e36w3_ffc_on);
+	dsim_write_data_table(dsim, s6e36w3_circle_mask);
+	dsim_write_data_seq(dsim, false, 0xF0, 0xA5, 0xA5);		/* test key off */
+	msleep(100);	/* sleep-out settle: 120 ms in total, as before */
+	/* Tizen s6e36w3x01_displayon: restore brightness, then display on */
+	s6e36w3x01_write_brightness(dsim, s6e36w3_last_lv);
+	dsim_write_data_seq_delay(dsim, 20, MIPI_DCS_SET_DISPLAY_ON);
+
+	s6e36w3x01_read_pm(dsim, "after");
+
+	mutex_unlock(&panel->ops_lock);
+	s6e36w3_diag_panel = panel;
+	s6e36w3_diag_round = 0;
+	schedule_delayed_work(&s6e36w3_diag_work, msecs_to_jiffies(300));
+	DPU_INFO_PANEL("%s -\n", __func__);
+	return 0;
+}
+
+/*
+ * HLPM (high-brightness low-power mode): the panel's AOD mode, used for Wear OS
+ * ambient (DOZE / DOZE_SUSPEND). Sequences from Samsung's Tizen driver
+ * (s6e36w3x01_hlpm_ctrl): analog setup FD (ON/OFF variant), then 0x53 selects
+ * the mode: 0x02 = HLPM 40 nit, 0x03 = HLPM 5 nit, 0x00 = normal.
+ */
+static u8 s6e36w3_hlpm_on_etc[] = {
+	0xFD, 0x88, 0x05, 0x3E, 0x80, 0x0A, 0x00, 0xEC, 0x25,
+	0x00, 0x00, 0x0A, 0xAA, 0x44, 0xD0,
+};
+static u8 s6e36w3_hlpm_off_etc[] = {
+	0xFD, 0x88, 0x05, 0x3E, 0x80, 0x0A, 0x00, 0x6C, 0x25,
+	0x00, 0x00, 0x0A, 0xAA, 0x44, 0x10,
+};
+
+/* 5 nit below ~40 % of the brightness range, 40 nit above */
+static u8 s6e36w3_hlpm_level(u32 br)
+{
+	return br < 102 ? 0x03 : 0x02;
+}
+
+/* caller holds panel->ops_lock */
+static void s6e36w3x01_hlpm_write(struct dsim_device *dsim, bool on)
+{
+	dsim_write_data_seq(dsim, false, 0xF0, 0x5A, 0x5A);	/* test key on */
+	dsim_write_data_seq(dsim, false, 0xFC, 0x5A, 0x5A);	/* test key lv3 on */
+	if (on) {
+		dsim_write_data_table(dsim, s6e36w3_hlpm_on_etc);
+		dsim_write_data_seq(dsim, false, 0x53, s6e36w3_hlpm_level(s6e36w3_doze_br));
+	} else {
+		dsim_write_data_table(dsim, s6e36w3_hlpm_off_etc);
+		dsim_write_data_seq(dsim, false, 0x53, 0x00);
+	}
+	dsim_write_data_seq(dsim, false, 0xFC, 0xA5, 0xA5);
+	dsim_write_data_seq(dsim, false, 0xF0, 0xA5, 0xA5);
+	s6e36w3_hlpm = on;
+}
+
+static int s6e36w3x01_doze(struct exynos_panel_device *panel)
+{
+	struct dsim_device *dsim = get_dsim_drvdata(0);
+
+	mutex_lock(&panel->ops_lock);
+	if (s6e36w3_hlpm || s6e36w3_dozing) {
+		mutex_unlock(&panel->ops_lock);
+		return 0;
+	}
+	if (r800_hlpm) {
+		s6e36w3x01_hlpm_write(dsim, true);
+	} else {
+		s6e36w3x01_write_brightness(dsim, 0);
+		s6e36w3_dozing = true;
+	}
+	mutex_unlock(&panel->ops_lock);
+	DPU_INFO_PANEL("%s: %s\n", __func__, !r800_hlpm ? "normal mode, level 0" :
+		       s6e36w3_hlpm_level(s6e36w3_doze_br) == 0x03 ? "HLPM on (5 nit)" : "HLPM on (40 nit)");
+	return 0;
+}
+
+static int s6e36w3x01_doze_suspend(struct exynos_panel_device *panel)
+{
+	/* same panel mode; DECON stops sending frames, the panel self-refreshes */
+	return s6e36w3x01_doze(panel);
+}
+
+static int s6e36w3x01_exit_doze(struct exynos_panel_device *panel)
+{
+	struct dsim_device *dsim = get_dsim_drvdata(0);
+
+	mutex_lock(&panel->ops_lock);
+	if (s6e36w3_hlpm)
+		s6e36w3x01_hlpm_write(dsim, false);
+	s6e36w3_dozing = false;
+	s6e36w3x01_write_brightness(dsim, s6e36w3_last_lv);
+	mutex_unlock(&panel->ops_lock);
+	DPU_INFO_PANEL("%s: HLPM off, level %u\n", __func__, s6e36w3_last_lv);
+	return 0;
+}
+
+/*
+ * HLPM image fade experiment: the picture loses pixels over a minute or two
+ * in HLPM; a new frame or re-sending 0x53 does not bring it back, a fresh
+ * entry from normal mode does. "Kick" re-sends part of the entry:
+ *   1: FD (HLPM_ON_ETC) + 53       2: full exit + entry (FD off/53 00, then on)
+ * echo N > /sys/module/panel_samsung_s6e36w3x01/parameters/r800_hlpm_kick
+ * r800_hlpm_refresh_ms > 0 repeats the kick mode set last, while in HLPM.
+ */
+static int r800_hlpm_kick_mode;
+static unsigned int r800_hlpm_refresh_ms;
+module_param(r800_hlpm_refresh_ms, uint, 0644);
+static void s6e36w3_kick_fn(struct work_struct *w);
+static DECLARE_DELAYED_WORK(s6e36w3_kick_work, s6e36w3_kick_fn);
+
+static void s6e36w3_kick(int mode)
+{
+	struct exynos_panel_device *panel = s6e36w3_diag_panel;
+	struct dsim_device *dsim = get_dsim_drvdata(0);
+
+	if (!panel || !dsim)
+		return;
+	mutex_lock(&panel->ops_lock);
+	if (s6e36w3_hlpm && dsim->state == DSIM_STATE_DOZE) {
+		if (mode == 2)
+			s6e36w3x01_hlpm_write(dsim, false);
+		s6e36w3x01_hlpm_write(dsim, true);
+	}
+	mutex_unlock(&panel->ops_lock);
+}
+
+static void s6e36w3_kick_fn(struct work_struct *w)
+{
+	if (!r800_hlpm_refresh_ms || !r800_hlpm_kick_mode)
+		return;
+	s6e36w3_kick(r800_hlpm_kick_mode);
+	schedule_delayed_work(&s6e36w3_kick_work, msecs_to_jiffies(r800_hlpm_refresh_ms));
+}
+
+static int r800_hlpm_kick_set(const char *val, const struct kernel_param *kp)
+{
+	int mode, ret = kstrtoint(val, 0, &mode);
+
+	if (ret)
+		return ret;
+	r800_hlpm_kick_mode = mode;
+	s6e36w3_kick(mode);
+	pr_info("[PANEL] HLPM kick %d (hlpm %d, refresh %u ms)\n", mode, s6e36w3_hlpm,
+		r800_hlpm_refresh_ms);
+	if (r800_hlpm_refresh_ms)
+		mod_delayed_work(system_wq, &s6e36w3_kick_work,
+				 msecs_to_jiffies(r800_hlpm_refresh_ms));
+	return 0;
+}
+static const struct kernel_param_ops r800_hlpm_kick_ops = {
+	.set = r800_hlpm_kick_set,
+	.get = param_get_int,
+};
+module_param_cb(r800_hlpm_kick, &r800_hlpm_kick_ops, &r800_hlpm_kick_mode, 0644);
+
+/*
+ * AID (AMOLED impulse dimming) and ELVSS per brightness level, from Samsung's
+ * Tizen driver (linux-4.9-exynos9110, dpu_9110/panels/s6e36w3x01_l_lcd_ctrl.c).
+ * Level 0 is the dimmest, 73 the brightest. The per-level gamma (0xCA) there
+ * is computed from the panel's MTP; we keep the gamma S-Boot programmed and
+ * dim with AID + ELVSS only.
+ */
+#define S6E36W3_LEVELS 74
+static const u8 s6e36w3_elvss[S6E36W3_LEVELS] = {
+	0x22, 0x22, 0x22, 0x22, 0x22, 0x22, 0x22, 0x22,
+	0x22, 0x22, 0x22, 0x22, 0x22, 0x22, 0x22, 0x22,
+	0x22, 0x22, 0x22, 0x22, 0x22, 0x22, 0x22, 0x22,
+	0x22, 0x22, 0x22, 0x22, 0x22, 0x22, 0x22, 0x22,
+	0x22, 0x22, 0x22, 0x21, 0x21, 0x20, 0x20, 0x1F,
+	0x1F, 0x1E, 0x1D, 0x1C, 0x1C, 0x1C, 0x1C, 0x1B,
+	0x1B, 0x1B, 0x1B, 0x1A, 0x1A, 0x19, 0x19, 0x18,
+	0x18, 0x18, 0x18, 0x18, 0x18, 0x17, 0x17, 0x17,
+	0x17, 0x17, 0x16, 0x16, 0x15, 0x15, 0x14, 0x14,
+	0x13, 0x13
+};
+static const u8 s6e36w3_aid[S6E36W3_LEVELS * 2] = {
+	0x01, 0x52, 0x01, 0x50, 0x01, 0x4B, 0x01, 0x49,
+	0x01, 0x43, 0x01, 0x41, 0x01, 0x3B, 0x01, 0x39,
+	0x01, 0x32, 0x01, 0x2F, 0x01, 0x2A, 0x01, 0x28,
+	0x01, 0x21, 0x01, 0x1B, 0x01, 0x13, 0x01, 0x0B,
+	0x01, 0x0A, 0x01, 0x02, 0x00, 0xFA, 0x00, 0xED,
+	0x00, 0xE9, 0x00, 0xE1, 0x00, 0xD3, 0x00, 0xC9,
+	0x00, 0xBC, 0x00, 0xB2, 0x00, 0xA4, 0x00, 0x97,
+	0x00, 0x89, 0x00, 0x89, 0x00, 0x89, 0x00, 0x89,
+	0x00, 0x89, 0x00, 0x89, 0x00, 0x89, 0x00, 0x89,
+	0x00, 0x89, 0x00, 0x89, 0x00, 0x89, 0x00, 0x89,
+	0x00, 0x89, 0x00, 0x89, 0x00, 0x89, 0x00, 0x89,
+	0x00, 0x80, 0x00, 0x6B, 0x00, 0x5A, 0x00, 0x49,
+	0x00, 0x32, 0x00, 0x32, 0x00, 0x32, 0x00, 0x32,
+	0x00, 0x32, 0x00, 0x32, 0x00, 0x32, 0x00, 0x32,
+	0x00, 0x32, 0x00, 0x32, 0x00, 0x2A, 0x00, 0x22,
+	0x00, 0x1A, 0x00, 0x12, 0x00, 0x10, 0x00, 0x10,
+	0x00, 0x10, 0x00, 0x10, 0x00, 0x10, 0x00, 0x10,
+	0x00, 0x10, 0x00, 0x10, 0x00, 0x10, 0x00, 0x10,
+	0x00, 0x10, 0x00, 0x10,
+};
+
+/* caller holds panel->ops_lock */
+static void s6e36w3x01_write_brightness(struct dsim_device *dsim, u32 lv)
+{
+	dsim_write_data_seq(dsim, false, 0xF0, 0x5A, 0x5A);	/* test key on */
+	dsim_write_data_seq(dsim, false, 0xFC, 0x5A, 0x5A);	/* test key lv3 on */
+	dsim_write_data_seq(dsim, false, 0xB1, s6e36w3_aid[lv * 2], s6e36w3_aid[lv * 2 + 1]);
+	dsim_write_data_seq(dsim, false, 0xB5, 0x19, lv < 21 ? 0xCC : 0xDC, s6e36w3_elvss[lv]);
+	dsim_write_data_seq(dsim, false, 0xF7, 0x03);		/* panel update */
+	dsim_write_data_seq(dsim, false, 0xFC, 0xA5, 0xA5);
+	dsim_write_data_seq(dsim, false, 0xF0, 0xA5, 0xA5);
+}
+
+static int s6e36w3x01_set_light(struct exynos_panel_device *panel, u32 br_val)
+{
+	struct dsim_device *dsim = get_dsim_drvdata(0);
+	u32 br = br_val > 255 ? 255 : br_val;
+	u32 lv = br * (S6E36W3_LEVELS - 1) / 255;
+
+	mutex_lock(&panel->ops_lock);
+	if (br_val)
+		s6e36w3_doze_br = br;
+	if (s6e36w3_dozing) {
+		/* ambient in normal mode stays at level 0 */
+		mutex_unlock(&panel->ops_lock);
+		return 0;
+	}
+	if (s6e36w3_hlpm) {
+		/* in HLPM only the two AOD levels exist; 0 (screen off) is ignored */
+		if (br_val) {
+			dsim_write_data_seq(dsim, false, 0xF0, 0x5A, 0x5A);
+			dsim_write_data_seq(dsim, false, 0x53, s6e36w3_hlpm_level(br));
+			dsim_write_data_seq(dsim, false, 0xF0, 0xA5, 0xA5);
+		}
+		mutex_unlock(&panel->ops_lock);
+		return 0;
+	}
+	s6e36w3_last_lv = lv;
+	s6e36w3x01_write_brightness(dsim, lv);
+	mutex_unlock(&panel->ops_lock);
+	DPU_INFO_PANEL("%s: br %u -> level %u aid %02x%02x\n", __func__, br, lv,
+		       s6e36w3_aid[lv * 2], s6e36w3_aid[lv * 2 + 1]);
+	return 0;
+}
+
+struct exynos_panel_ops panel_s6e36w3x01_ops = {
+	/* lcdtype from the S-Boot cmdline; must match ddi_id/id in the DT */
+	.id		= {0x407052, 0xffffff, 0xffffff},
+	.suspend	= s6e36w3x01_suspend,
+	.displayon	= s6e36w3x01_displayon,
+	.doze		= s6e36w3x01_doze,
+	.doze_suspend	= s6e36w3x01_doze_suspend,
+	.exit_doze	= s6e36w3x01_exit_doze,
+	.set_light	= s6e36w3x01_set_light,
+};
