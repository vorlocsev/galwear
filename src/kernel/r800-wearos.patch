+int k6ds_gyro_open_calibration(struct ssp_data *data)
+{
+	int iRet = 0;
+	mm_segment_t old_fs;
+	struct file *cal_filp = NULL;
+
+	old_fs = get_fs();
+	set_fs(KERNEL_DS);
+
+	cal_filp = filp_open(CALIBRATION_FILE_PATH, O_RDONLY | O_NOFOLLOW, 0660);
+	if (IS_ERR(cal_filp)) {
+		set_fs(old_fs);
+		iRet = PTR_ERR(cal_filp);
+
+		data->gyrocal.x = 0;
+		data->gyrocal.y = 0;
+		data->gyrocal.z = 0;
+
+		return iRet;
+	}
+
+	iRet = vfs_read(cal_filp, (char *)&data->gyrocal, 3 * sizeof(int), &cal_filp->f_pos);
+
+	if (iRet != 3 * sizeof(int))
+		iRet = -EIO;
+
+	filp_close(cal_filp, current->files);
+	set_fs(old_fs);
+
+	ssp_dbg("[SSP]: open gyro calibration %d, %d, %d\n",
+		data->gyrocal.x, data->gyrocal.y, data->gyrocal.z);
+	return iRet;
+}
