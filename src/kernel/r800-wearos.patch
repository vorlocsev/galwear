+	rwlock_t rw_lock;
+};
+
+static char cp_ubuf[SSP_DEBUG_MSG_LEN];
+static struct ssp_packet_dump ssp_pkt_dp[2] = {
+	{
+		.dp_name = "bbd_send_pkt",
+		.rw_lock = __RW_LOCK_UNLOCKED(bbd_lock),
+	},
+	{
