+/*
+ * SM-R800: pd-dispaud is kept on at all times (DECON holds no genpd reference
+ * and SErrors with the domain off), but Tizen sleeps with it off (its
+ * devfreq_aud reads 0 at suspend) and our full SLEEP hangs in the firmware
+ * with it on. r800_dispaud_sleep_off=1 switches it off as the last step
+ * before the platform suspend (syscore, one CPU, IRQs off; registered after
+ * exynos-pm, so it runs before exynos_pm_syscore_suspend) and back on as the
+ * last syscore resume step, before any driver runs again. Raw cal_pd_control:
+ * the genpd/exynos-pd paths take mutexes.
+ */
+#include <linux/syscore_ops.h>
+static bool r800_dispaud_sleep_off;
+module_param(r800_dispaud_sleep_off, bool, 0644);
+static struct exynos_pm_domain *r800_dispaud;
+static bool r800_dispaud_was_on;
+
+/*
+ * The abox probe sets CMU_DISPAUD CONTROLLER_OPTION bit 31 (base-tree code,
+ * 0x30000000 -> 0xb0000000); Tizen never sets it, and its DISPAUD power-off
+ * succeeds where ours timed out (DISPAUD_STATUS 0x15000f). With
+ * r800_dispaud_clr_b31=1 (default) the bit is cleared right before the
+ * sleep power-off and set again once the domain is back on.
+ */
+static bool r800_dispaud_clr_b31 = true;
+module_param(r800_dispaud_clr_b31, bool, 0644);
+static void __iomem *r800_cmu_dispaud;
+static u32 r800_ctrl_opt_saved;
+#define R800_CTRL_OPT	0x800
+
+/* Latch unverified recovery until reboot; never silently retry suspend. */
+static int r800_pd_fault;
+
+static int r800_ctrl_opt_restore(void)
+{
+	if (!r800_ctrl_opt_saved)
+		return 0;
+	if (!r800_cmu_dispaud ||
+	    cal_pd_status(r800_dispaud->cal_pdid) != 1)
+		return -EIO;
+	writel(r800_ctrl_opt_saved, r800_cmu_dispaud + R800_CTRL_OPT);
+	if (readl(r800_cmu_dispaud + R800_CTRL_OPT) != r800_ctrl_opt_saved)
+		return -EIO;
+	r800_ctrl_opt_saved = 0;
+	return 0;
+}
+
+/*
+ * pd-is and pd-vts are kept on at sync (IS holds the MIPI PHY the DSIM uses;
+ * powering VTS off made EL3 fault with the 4.19 PD SMC argument). Tizen's
+ * genpd powers every unused domain off, so its SLEEP runs with them off; the
+ * SoC sleep sequence then waits on TOP_BUS with nothing left on. Bit 0 of
+ * r800_sleep_pd_off switches pd-is off for sleep, bit 1 pd-vts, in the same
+ * syscore step as pd-dispaud (raw cal_pd_control, status checked).
+ * Bit 2: pd-g3d. Mali leaves its domain on through system suspend; with it
+ * on, exit_sleep writes the G3D BUS_COMPONENT_DRCG_EN (conditional on the
+ * G3D status) to a block that no longer answers and SErrors.
+ */
+static unsigned int r800_sleep_pd_off;
+module_param(r800_sleep_pd_off, uint, 0644);
+static const char * const r800_sleep_pd_name[] = { "pd-is", "pd-vts", "pd-g3d" };
+static struct exynos_pm_domain *r800_sleep_pd[ARRAY_SIZE(r800_sleep_pd_name)];
+static bool r800_sleep_pd_was_on[ARRAY_SIZE(r800_sleep_pd_name)];
+
+static int r800_pd_control_checked(struct exynos_pm_domain *pd, bool on)
+{
+	int ret = cal_pd_control(pd->cal_pdid, on);
+	int status = cal_pd_status(pd->cal_pdid);
+
+	if (ret || status != (int)on) {
+		pr_err("r800-pd: %s target=%d CAL=%d status=%d\n",
+		       pd->name, on, ret, status);
+		return ret < 0 ? ret : -EIO;
+	}
+	return 0;
+}
+
+static int r800_sleep_pds_off(void)
+{
+	int i, status, ret;
+
+	for (i = 0; i < ARRAY_SIZE(r800_sleep_pd); i++) {
+		struct exynos_pm_domain *pd = r800_sleep_pd[i];
+
+		if (!(r800_sleep_pd_off & BIT(i)))
+			continue;
+		if (!pd)
+			return -ENODEV;
+		status = cal_pd_status(pd->cal_pdid);
+		if (status == 0)
+			continue;
+		if (status != 1)
+			return status < 0 ? status : -EIO;
+		/* Record attempted transitions before CAL may partially change hardware. */
+		r800_sleep_pd_was_on[i] = true;
+		ret = r800_pd_control_checked(pd, false);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int r800_sleep_pds_on(void)
+{
+	int i, ret, first = 0;
+
+	for (i = ARRAY_SIZE(r800_sleep_pd) - 1; i >= 0; i--) {
+		if (!r800_sleep_pd_was_on[i])
+			continue;
+		ret = r800_pd_control_checked(r800_sleep_pd[i], true);
+		if (ret) {
+			if (!first)
+				first = ret;
+		} else {
+			r800_sleep_pd_was_on[i] = false;
+		}
+	}
+	return first;
+}
+
+/*
+ * Live test: echo pd-vts > /sys/module/exynos_pd/parameters/r800_pd_off
+ * powers that domain off now (r800_pd_on: back on), through the normal
+ * exynos-pd path with its mutex, and logs the PMU status. For checking
+ * whether a kept-on domain can go off at all before trying it in SLEEP.
+ */
+static int r800_pd_set(const char *val, bool on)
+{
+	char name[24];
+	struct exynos_pm_domain *pd;
+	int ret;
+
+	strlcpy(name, val, sizeof(name));
+	strim(name);
+	pd = exynos_pd_lookup_name(name);
+	if (!pd)
+		return -ENODEV;
+	pr_info("r800-pd: %s %s requested (status %d)\n", name, on ? "on" : "off",
+		cal_pd_status(pd->cal_pdid));
+	if (on) {
+		ret = exynos_pd_power_on(pd);
+	} else {
+		mutex_lock(&pd->access_lock);
+		atomic_set(&pd->need_sync, 0);
+		ret = __exynos_pd_power_off(pd);
+		mutex_unlock(&pd->access_lock);
+	}
+	pr_info("r800-pd: %s %s -> %d (status %d)\n", name, on ? "on" : "off", ret,
+		cal_pd_status(pd->cal_pdid));
+	return ret < 0 ? ret : 0;
+}
+
+static int r800_pd_off_set(const char *val, const struct kernel_param *kp)
+{
+	return r800_pd_set(val, false);
+}
+
+static int r800_pd_on_set(const char *val, const struct kernel_param *kp)
+{
+	return r800_pd_set(val, true);
+}
+
+static const struct kernel_param_ops r800_pd_off_ops = { .set = r800_pd_off_set };
+static const struct kernel_param_ops r800_pd_on_ops = { .set = r800_pd_on_set };
+module_param_cb(r800_pd_off, &r800_pd_off_ops, NULL, 0200);
+module_param_cb(r800_pd_on, &r800_pd_on_ops, NULL, 0200);
+
+static int r800_pd_restore(void)
+{
+	int ret, first = 0;
+
+	/* DISPAUD was switched last: restore it before the earlier domains. */
+	if (r800_dispaud_was_on) {
+		ret = r800_pd_control_checked(r800_dispaud, true);
+		if (ret)
+			first = ret;
+		else
+			r800_dispaud_was_on = false;
+	}
+	/* A failed clock write may precede any attempted power-off. */
+	if (!first) {
+		ret = r800_ctrl_opt_restore();
+		if (ret)
+			first = ret;
+	}
+	ret = r800_sleep_pds_on();
+	return first ? first : ret;
+}
+
+static int r800_pd_syscore_suspend(void)
+{
+	int ret, status, rollback;
+
+	if (r800_pd_fault)
+		return r800_pd_fault;
+	if (r800_sleep_pd_off & ~((1U << ARRAY_SIZE(r800_sleep_pd)) - 1))
+		return -EINVAL;
+	ret = r800_sleep_pds_off();
+	if (ret)
+		goto abort;
+	if (!r800_dispaud_sleep_off)
+		return 0;
+	if (!r800_dispaud) {
+		ret = -ENODEV;
+		goto abort;
+	}
+	status = cal_pd_status(r800_dispaud->cal_pdid);
+	if (status == 0)
+		return 0;
+	if (status != 1) {
+		ret = status < 0 ? status : -EIO;
+		goto abort;
+	}
+	if (abox_is_on()) {
+		ret = -EBUSY;
+		goto abort;
+	}
+	if (r800_dispaud_clr_b31 && !r800_cmu_dispaud) {
+		ret = -ENODEV;
+		goto abort;
+	}
+	if (r800_dispaud_clr_b31) {
+		u32 v = readl(r800_cmu_dispaud + R800_CTRL_OPT);
+
+		if (v & BIT(31)) {
+			r800_ctrl_opt_saved = v;
+			writel(v & ~BIT(31), r800_cmu_dispaud + R800_CTRL_OPT);
+			if (readl(r800_cmu_dispaud + R800_CTRL_OPT) != (v & ~BIT(31))) {
+				ret = -EIO;
+				goto abort;
+			}
+		}
+	}
+	r800_dispaud_was_on = true;
+	ret = r800_pd_control_checked(r800_dispaud, false);
+	if (!ret)
+		return 0;
+abort:
+	/* syscore does not resume its own failed suspend callback. */
+	rollback = r800_pd_restore();
+	r800_pd_fault = rollback ? rollback : ret;
+	pr_err("r800-pd: suspend aborted (%d), restore result=%d; blocked until reboot\n",
+	       ret, rollback);
+	return r800_pd_fault;
+}
+
+static void r800_pd_syscore_resume(void)
+{
+	int ret = r800_pd_restore();
+
+	if (ret) {
+		r800_pd_fault = ret;
+		pr_err("r800-pd: resume recovery unverified (%d); blocked until reboot\n", ret);
+	}
+}
+
+static struct syscore_ops r800_pd_syscore_ops = {
+	.suspend	= r800_pd_syscore_suspend,
+	.resume		= r800_pd_syscore_resume,
+};
+
+static int __init r800_pd_syscore_init(void)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(r800_sleep_pd_name); i++)
+		r800_sleep_pd[i] = exynos_pd_lookup_name(r800_sleep_pd_name[i]);
+	r800_dispaud = exynos_pd_lookup_name("pd-dispaud");
+	if (!r800_dispaud)
+		pr_err("r800-pd: pd-dispaud not found\n");
+	else
+		r800_cmu_dispaud = ioremap(0x14980000, SZ_4K);
+	register_syscore_ops(&r800_pd_syscore_ops);
+	return 0;
+}
+late_initcall_sync(r800_pd_syscore_init);
+
 static void exynos_pd_exit(void)
 {
 	return platform_driver_unregister(&exynos_pd_driver);
