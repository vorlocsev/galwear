+			&& (buffer[1] == SUCCESS)
+			&& (buffer[2] == SUCCESS)
+			&& (buffer[3] == SUCCESS)
+			&& (buffer[4] == SUCCESS))
+		bMcuTestSuccessed = true;
+
+	ssp_dbg("[SSP]: MCU Factory Test Result - %s, %s, %s\n",
+		data->model_name, (bMcuTestSuccessed ? "OK" : "NG"), "OK");
