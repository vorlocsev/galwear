diff --git a/drivers/motor/ztm620_motor.c b/drivers/motor/ztm620_motor.c
new file mode 100644
index 000000000..f95609388
--- /dev/null
+++ b/drivers/motor/ztm620_motor.c
@@ -0,0 +1,1262 @@
+/*
