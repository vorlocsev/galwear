+static ssize_t hrm_led_g_ir_show(struct device *dev,
+	struct device_attribute *attr, char *buf)
+{
+  int iRet = 0;
+
+  int32_t buffer[2] = {0, };
+  int32_t g_led=0, ir=0;
+  struct ssp_data *data = dev_get_drvdata(dev);
+  struct ssp_msg *msg;
