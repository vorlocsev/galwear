+#ifdef SSP_DEBUG_LOG
+	pr_info("[SSP]%s, ohm=%d adc=%d inj_c=%d\n", __func__,
+		data->buf[GSR_SENSOR].ohm, data->buf[GSR_SENSOR].adc, data->buf[GSR_SENSOR].inj_c);
